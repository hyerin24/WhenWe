# 이 파일은 "키 구조"만 공유하기 위한 예시입니다. 실제 값을 여기에 적지 마세요.
# 사용법: cp .env.example .env  → .env 에만 실제 값을 채웁니다. (.env 는 커밋되지 않습니다)

# ─── 서버 ──────────────────────────────────────
PORT=3000
NODE_ENV=development
# 콤마로 여러 origin을 허용할 수 있습니다.
# 배포 예시: CORS_ORIGIN=https://when-we.vercel.app,https://lms.kyonggi.ac.kr
CORS_ORIGIN=http://localhost:5173

# ─── Supabase ─────────────────────────────────
# 최신 키 체계(Publishable / Secret)를 사용합니다.
# Supabase 대시보드 → Project Settings → API Keys 에서 복사합니다.
SUPABASE_URL=

# 공개되어도 되는 키. 사용자 JWT와 함께 쓰며 RLS 를 적용받습니다.
SUPABASE_PUBLISHABLE_KEY=

# ⚠️ Secret 키는 RLS를 우회하는 관리자 키입니다. (예전 이름: SERVICE_ROLE)
#    서버에서만 사용하고, 프론트엔드 환경변수(VITE_ / NEXT_PUBLIC_)로 절대 옮기지 마세요.
#    CLAUDE.md · CONTRIBUTING.md 의 `SUPABASE_SERVICE_ROLE_KEY` 금지 규칙이 이 키에 그대로 적용됩니다.
SUPABASE_SECRET_KEY=


# ══════════════════════════════════════════════════════════════
# 여기에 "일부러" 넣지 않은 것 — 추가하지 마세요
# ══════════════════════════════════════════════════════════════
#
# LMS_USER_ID / LMS_PASSWORD
#   → 학교 ID/PW를 서버에 저장하거나 사용자를 대신해 로그인하지 않기로 결정했습니다.
#     이런 키가 추가된 PR은 리뷰에서 반려합니다.
#
# LMS_ICAL_URL
#   → iCal 구독 URL은 URL 자체가 인증 토큰이고 사용자마다 다릅니다.
#     서버 공용 환경변수가 아니라, 각 사용자의 DB 레코드에 저장합니다.
#     로그·에러 메시지·API 응답에 그대로 남기지 마세요.
