# 이 파일은 "키 구조"만 공유하기 위한 예시입니다. 실제 값을 여기에 적지 마세요.
# 사용법: cp .env.example .env  → .env 에만 실제 값을 채웁니다. (.env 는 커밋되지 않습니다)
#
# ⚠️ 프론트엔드 환경변수는 빌드 결과물에 그대로 포함되어 누구나 볼 수 있습니다.
#    서버 전용 키(SUPABASE_SERVICE_ROLE_KEY)를 여기에 절대 넣지 마세요.
#
# ※ 접두사는 빌드 도구에 따라 다릅니다. Vite = VITE_ / Next.js = NEXT_PUBLIC_
#    실제 사용하는 도구에 맞춰 수정하세요.

# ─── 백엔드 API ────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────
# ANON_KEY는 프론트엔드 노출을 전제로 만들어진 키입니다.
# 단, 데이터 접근 제어는 Supabase RLS 정책에 의존하므로 테이블마다 RLS를 켜야 합니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Mock 모드 ────────────────────────────────
# true  = 서버 없이 프론트만 실행 (기본값. 이 파일/.env 가 없어도 mock 으로 뜹니다)
# false = 위 VITE_API_BASE_URL / Supabase 로 실제 연결
VITE_USE_MOCK=true
